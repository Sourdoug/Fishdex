# Copiez ce fichier en ".env" puis remplissez les valeurs.
# Ne publiez JAMAIS votre fichier .env (il est ignoré par git).

# Token du bot : https://discord.com/developers/applications > votre app > Bot > Reset Token
DISCORD_TOKEN=

# ID de l'application : onglet "General Information" > Application ID
CLIENT_ID=

# (Optionnel) ID de votre serveur de test : les commandes y apparaissent instantanément.
# Laissez vide pour déployer les commandes globalement (jusqu'à 1 h de propagation).
GUILD_ID=
